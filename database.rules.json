{
  "rules": {
    "tomatoes": {
      ".read": "true",
      "$tomatoId": {
        ".write": "auth != null",
        "verified": { ".validate": "newData.isBoolean()" },
        "probableError": { ".validate": "newData.isBoolean()" },
        "uid": { ".validate": "!data.exists() ? newData.val() === auth.uid : true" },
        "likes": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
        "contributors": { ".write": "auth != null" }
      }
    },
    "pepins": {
      ".read": "true",
      "admins": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === 'C2FrKuBXBzRYcqCG7pW8eEzm5RI3' || auth.uid === '1uKGbtsFGOYKTwge7lT88yAfnx92' || auth.uid === 'ptNpn0JJF1Serl8Ej7yAJLtpPti2' || auth.uid === 'pJVYaoxxs2UReJ2bcp5VWSLvl6x2')"
      },
      "tomatoes": {
        "$id": {
          ".write": "auth != null && (auth.uid === 'C2FrKuBXBzRYcqCG7pW8eEzm5RI3' || auth.uid === '1uKGbtsFGOYKTwge7lT88yAfnx92' || auth.uid === 'ptNpn0JJF1Serl8Ej7yAJLtpPti2' || auth.uid === 'pJVYaoxxs2UReJ2bcp5VWSLvl6x2' || root.child('pepins/admins').child(auth.uid).val() === true)",
          "likes": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
          "comments": { "$cid": { ".write": "auth != null && !data.exists()" } }
        }
      }
    },
    "admins": { ".read": "auth != null", ".write": "false" },
    "users": { "$uid": { ".read": "true", ".write": "auth != null && auth.uid === $uid" } },
    "meta": { ".read": "true", ".write": "true" }
  }
}
