{
  "rules": {
    "tomatoes": {
      ".read": "true",
      "$tomatoId": {
        ".write": "auth != null",
        "verified": { ".validate": "newData.isBoolean()" },
        "probableError": { ".validate": "newData.isBoolean()" },
        "uid": { ".validate": "!data.exists() ? newData.val() === auth.uid : true" },
        "likes": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
        "contributors": { ".write": "auth != null" }
      }
    },
    "pepins": {
      ".read": "true",
      "owner": { ".write": "false" },
      "editors": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('pepins/owner').val() === auth.uid"
      },
      "varieties": {
        ".write": "auth != null && (root.child('pepins/owner').val() === auth.uid || (auth.token.email_verified === true && root.child('pepins/editors').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true))",
        "$k": {
          ".validate": "!newData.exists() || (newData.child('nom').isString() && newData.child('nom').val().length > 0 && newData.child('nom').val().length < 200)"
        }
      }
    },
    "admins": { ".read": "auth != null", ".write": "false" },
    "users": { "$uid": { ".read": "true", ".write": "auth != null && auth.uid === $uid" } },
    "meta": { ".read": "true", ".write": "true" }
  }
}
